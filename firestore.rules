rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global System Configuration (Announcements, App Feature Flags)
    match /global_system_config/{configId} {
      allow read, write: if true;
    }

    // Real Fellowship Community Members
    match /fellowship_members/{memberId} {
      allow read, write: if true;
    }

    // Fellowship Chat Messages & Channels
    match /fellowship_messages/{messageId} {
      allow read, write: if true;
    }

    match /fellowship_channels/{channelId} {
      allow read, write: if true;
    }

    // Open read/write for all application collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
