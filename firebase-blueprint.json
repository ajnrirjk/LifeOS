{
  "entities": {
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A chat message sent in Fellowship Discord chat",
      "type": "object",
      "properties": {
        "channelId": { "type": "string", "maxLength": 100 },
        "serverId": { "type": "string", "maxLength": 100 },
        "text": { "type": "string", "maxLength": 5000 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 128 },
        "senderPhoto": { "type": "string", "maxLength": 1000 },
        "senderEmail": { "type": "string", "maxLength": 256 },
        "senderRole": { "type": "string", "maxLength": 64 },
        "senderRoleColor": { "type": "string", "maxLength": 32 },
        "isGoogleUser": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "reactions": { "type": "object" },
        "replyTo": { "type": "object" },
        "pinned": { "type": "boolean" },
        "embed": { "type": "object" },
        "attachment": { "type": "object" }
      },
      "required": ["channelId", "text", "senderId", "senderName", "createdAt"]
    },
    "ChatChannel": {
      "title": "ChatChannel",
      "description": "A channel in a Fellowship server",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "serverId": { "type": "string", "maxLength": 100 },
        "topic": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["text", "voice", "announcement"] },
        "emoji": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "number" },
        "lastMessage": { "type": "string", "maxLength": 500 },
        "lastMessageTime": { "type": "number" }
      },
      "required": ["name", "serverId", "createdAt"]
    },
    "GlobalSystemConfig": {
      "title": "GlobalSystemConfig",
      "description": "Global broadcasts, announcements, and application feature flags across all devices",
      "type": "object",
      "properties": {
        "activeAnnouncement": { "type": "object" },
        "appVisibility": { "type": "object" },
        "maintenanceMode": { "type": "boolean" },
        "maintenanceMessage": { "type": "string" },
        "updatedAt": { "type": "number" }
      }
    },
    "FellowshipMember": {
      "title": "FellowshipMember",
      "description": "Real active believer profile in the global fellowship roster",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "handle": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 32 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "role": { "type": "string", "enum": ["user", "moderator", "admin", "superadmin"] },
        "status": { "type": "string", "enum": ["active", "muted", "banned"] },
        "email": { "type": "string", "maxLength": 256 },
        "lastActive": { "type": "string", "maxLength": 64 },
        "xp": { "type": "number" },
        "streak": { "type": "number" },
        "warningsCount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "isOnline": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "handle", "role"]
    }
  },
  "firestore": {
    "/fellowship_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Public fellowship chat messages stream across channels"
    },
    "/fellowship_channels/{channelId}": {
      "schema": "ChatChannel",
      "description": "Fellowship channels and topics"
    },
    "/global_system_config/{configId}": {
      "schema": "GlobalSystemConfig",
      "description": "Global device announcements and app visibility flags"
    },
    "/fellowship_members/{memberId}": {
      "schema": "FellowshipMember",
      "description": "Real registered members in fellowship community"
    }
  }
}
